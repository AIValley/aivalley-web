generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         String     @default("USER") // USER | ADMIN
  createdAt    DateTime   @default(now())
  sessions     Session[]
  favorites    Favorite[]
  submissions  Resource[] @relation("SubmittedBy")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id            String     @id @default(uuid())
  uuid          String     @unique @default(uuid())
  type          String // tool | model | agent | learning
  nameEn        String
  nameZh        String
  descEn        String
  descZh        String
  nameI18n      String     @default("{}") // JSON 字符串对象：{ "zh-TW": "...", ja: "..." }
  descI18n      String     @default("{}") // JSON 字符串对象：多语言描述
  url           String
  category      String
  tags          String     @default("[]") // JSON 字符串数组
  pricing       String     @default("free") // free | freemium | paid
  logo          String?
  featured      Boolean    @default(false)
  status        String     @default("PUBLISHED") // PUBLISHED | PENDING
  submittedById String?
  submittedBy   User?      @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  favorites     Favorite[]
  tool          Tool?
  model         Model?
  agent         Agent?
  skill         Skill?
  learning      Learning?
  prompt        Prompt?
  dataset       Dataset?

  @@index([status])
  @@index([type])
  @@index([category])
}

model Tool {
  id         String   @id @default(uuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  platform   String? // web | desktop | mobile | cli | plugin | ide
  apiAccess  Boolean  @default(false)
}

model Model {
  id            String   @id @default(uuid())
  resourceId    String   @unique
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  provider      String?
  openSource    Boolean  @default(false)
  contextWindow Int?
  modalities    String   @default("[]") // JSON 数组
}

model Agent {
  id         String   @id @default(uuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  agentKind  String? // framework | autonomous | platform
  openSource Boolean  @default(false)
}

model Skill {
  id            String   @id @default(uuid())
  resourceId    String   @unique
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  author        String?
  version       String?
  trigger       String?
  githubRepo    String? // "owner/repo"
  summaryEn     String?
  summaryZh     String?
  skillMd       String? // SKILL.md 原文（Markdown）
  files         String   @default("[]") // JSON 数组：文件路径
  versions      String   @default("[]") // JSON 数组：版本历史
  githubStars   Int?
  githubForks   Int?
  securityIndex Int? // 0–100
}

model Learning {
  id         String   @id @default(uuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  level      String? // beginner | intermediate | advanced
  format     String? // course | tutorial | papers | video | guide
}

model Prompt {
  id         String   @id @default(uuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  content    String? // 提示词正文
  model      String? // 目标模型，如 GPT-4o / Claude
  author     String?
  variables  String   @default("[]") // JSON 数组：模板变量名
}

model Dataset {
  id         String   @id @default(uuid())
  resourceId String   @unique
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  format     String? // csv | json | parquet | sql | …
  rows       Int?
  license    String?
  source     String? // Hugging Face / Kaggle / …
  columns    String   @default("[]") // JSON 数组：列/字段名
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([resourceId])
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleZh   String
  contentEn String
  contentZh String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnumOption {
  id        String   @id @default(cuid())
  kind      String // type | category | pricing | status
  value     String // 存进 Resource 的原始值："tool"、"chat"、"free"、"PUBLISHED"…
  labelI18n String   @default("{}") // JSON 多语言标签：{ "zh":"工具", "en":"Tools", … }
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
  @@index([kind, sortOrder])
}
